# Copier ce fichier vers .env et remplir les valeurs

# Serveur
PORT=4000
NODE_ENV=development
# Origine du frontend (pour CORS + cookies)
CLIENT_ORIGIN=http://localhost:5173

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lekol_pam

# Session (cookie httpOnly) — mettre une longue chaine aleatoire
SESSION_SECRET=change-moi-en-une-longue-chaine-aleatoire

# Courriel (API Resend, via fetch) — les courriels partent reellement.
# L'API HTTPS est utilisee plutot que le relais SMTP : certains hebergeurs
# (dont Railway, observe en pratique) bloquent ou ralentissent fortement les
# connexions sortantes en SMTP, ce qui faisait echouer le demarrage du serveur.
#   https://resend.com -> API Keys -> Create API Key
#   RESEND_API_KEY = la cle generee (commence par re_)
#   MAIL_FROM = une adresse sur un domaine verifie dans Resend (Domains -> Add
#     Domain, puis ajouter les enregistrements DNS proposes). Sans domaine
#     verifie, seul l'expediteur onboarding@resend.dev fonctionne, et
#     uniquement vers l'adresse du compte Resend (mode bac a sable).
RESEND_API_KEY=
MAIL_FROM="Lekol Pam <votre.adresse.validee@exemple.com>"
OTP_EXPIRATION_MIN=10

# SMS (API Textbelt, via fetch) — desactive si absent.
#   https://textbelt.com -> acheter une cle (choisir la couverture
#   "International", pas "North America seulement", pour livrer vers Haiti)
TEXTBELT_API_KEY=

# Assistant IA (Groq, gratuit, compatible API OpenAI) — desactive si absent.
#   https://console.groq.com -> API Keys -> Create API Key
#   Groq retire regulierement d'anciens modeles : si vide, le code utilise son
#   propre defaut (voir backend/src/config/ia.js) plutot qu'une valeur figee ici.
GROQ_API_KEY=
GROQ_MODEL=

# Paiement mobile (agregateur plopplop : MonCash, NatCash, KashPay) —
# desactive si absent. client_id fourni par plopplop, jamais expose au frontend.
PLOPPLOP_CLIENT_ID=
# Valeur payment_method plopplop pour la carte Visa/Mastercard (defaut : card).
PLOPPLOP_METHODE_CARTE=
# Domaines autorises pour rediriger le parent vers la page de paiement
# (separes par des virgules, sous-domaines inclus). Defaut : solutionip.app.
PLOPPLOP_DOMAINES_REDIRECTION=

# Connexion Google (Google Identity Services) — desactive si absent.
#   https://console.cloud.google.com/apis/credentials -> Creer des identifiants
#   -> ID client OAuth -> type "Application Web" -> ajouter le(s) domaine(s) du
#   site dans "Origines JavaScript autorisees" (aucune URI de redirection requise,
#   ce flux n'en utilise pas). GOOGLE_CLIENT_ID n'est pas un secret.
GOOGLE_CLIENT_ID=

# Alertes de securite (compte verrouille, rafale d'echecs de connexion ou
# d'erreurs serveur, anomalie de paiement) : courriel(s) destinataire(s),
# separes par des virgules. Vide = alertes seulement dans les logs et la
# table journal_securite.
ALERTE_COURRIEL=
